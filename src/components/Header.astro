---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
import Logo from '../assets/logo.png';
---
<style>
.centerparentdiv {
  position: relative;
}
.centerchilddiv {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}
</style>
<header>
	<div style="background-color:#36454F">

                <table style="width:100%">
                    <tr style="width:100%">
                        <td align="center" width="100%">

                            <table>

                                <tr>
                                    <td valign="top" align="left" width="30%">
										<img src="src/images/logo.png" alt="" />
                                    </td>
									<td valign="top" align="left" width="80%">
                                        <b>
                                            <span style="font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;font-size:28.0pt;line-height:107%;color:lavender">
                                                SIMS SOFTWARE SOLUTIONS
                                            </span>
                                        </b>
                                    </td>

                                </tr>
<tr><td><br/></td></tr>
                                <tr>
                                    <td colspan="2" align="center" width="80%">

                                        <div class="centerparentdiv">
											<div class="centerchilddiv">
												
												<nav>
													<div class="internal-links" style={{color:"white"}}>
														<HeaderLink href="/">Home</HeaderLink>
														<HeaderLink href="/about">Privacy Statement</HeaderLink>
														<HeaderLink href="/whatsapp">Messaging</HeaderLink>
													</div>
												</nav>
											</div>
                                        </div>

                                    </td>
                                </tr>

                            </table>


                        </td>
                    </tr>
                </table>

<br/>
	</div>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
